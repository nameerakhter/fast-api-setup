# MongoDB — stores chat sessions and messages
# Local default (start MongoDB first). Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nata_chatbot
MONGODB_URI=mongodb://127.0.0.1:27017/nata_chatbot

# Google Gemini — required for chat answers, router, and embeddings
# Get a key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Models (defaults are fine for most setups)
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Must match the size used when you run generate_embeddings.py
EMBEDDING_DIMENSIONS=768

# Qdrant — vector database for FAQ + website knowledge search
# Cloud: copy URL + API key from https://cloud.qdrant.io
# Local example: QDRANT_URL=http://127.0.0.1:6333  (API key can be empty)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nata_knowledge

# API settings
# development = skip rate limiting (good for local work)
APP_ENV=development
# Streamlit runs here by default — used for CORS
CORS_ORIGIN=http://localhost:8501
# Rate limit (only enforced when APP_ENV is not development)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=25
